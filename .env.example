# =========================================================
# SMART DIGITAL LOCKER BACKEND - SPRING BOOT CONFIGURATION
# =========================================================

# Server Port
PORT=8080

# MySQL Database Configuration (e.g. Aiven MySQL or Local)
# Aiven Example: jdbc:mysql://<host>:<port>/defaultdb?sslMode=REQUIRED
DB_URL=jdbc:mysql://localhost:3306/smart_digital_locker?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Authentication (Minimum 32 characters / 256 bits)
JWT_SECRET=your_super_secret_jwt_signing_key_min_32_characters_production
JWT_EXPIRATION_MS=86400000

# File Upload Storage Directory
UPLOAD_DIR=./uploads

# Allowed CORS Origins (comma-separated, include deployed frontend URL)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
